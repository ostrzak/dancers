[resource]
script = ExtResource("1")
title = "Alternating-side catches"
variant_label = "Left hand first"
description = "Join, release, pass around your partner, then approach for a catch on the other side. One free bumper primes the nearest eligible pair."
narration_text = "Start with the gentleman's left hand joined to the lady's right. Release with a fresh press of the catching bumper. Guide the lady around the gentleman on a clear outside path, then approach for a catch using the other pair. Hold one free bumper near the new meeting point. The nearest eligible hands determine the catch."
requirement = ""
duration = 17.00000000
no_hands = false
single_hand = true
