[resource]
script = ExtResource("1")
title = "Behind, release, face, catch"
variant_label = "Gentleman CW / lady CCW"
description = "Release the rear hold, separate, turn toward each other, restore the forward arm stance and approach for a front catch."
narration_text = "Begin with a rear hand connection. Let the catching bumper up, then tap it again to release. Move apart and turn toward each other: the gentleman clockwise and the lady counterclockwise. Sweep the extended arms forward again with the D-pad. Approach slowly and hold one free bumper for a new front catch."
requirement = ""
duration = 24.00000000
no_hands = false
single_hand = true
