[resource]
script = ExtResource("1")
title = "Spinning planets"
variant_label = "Orbit CW / Gentleman CCW / lady CW"
description = "No hold. Orbit clockwise with both sticks. Use triggers to spin: gentleman counterclockwise, lady clockwise. L3/R3 reverse spin direction."
narration_text = "Both partners travel clockwise around their shared midpoint. Add gentle trigger pressure: the gentleman spins counterclockwise, and the lady spins clockwise. The left and right stick clicks reverse their respective spin directions. Keep the orbital path broad as the bodies turn."
requirement = ""
duration = 14.00000000
no_hands = true
single_hand = false
