[resource]
script = ExtResource("1")
title = "Open out and return"
variant_label = "Gentleman CW / lady CCW"
description = "One joined pair. Open into a small opposing turn, then steer back together. Try gentle trigger pulses; contraction also requests spin."
narration_text = "From one joined pair of hands, open into a small opposing turn. The gentleman turns clockwise and the lady counterclockwise. Use gentle trigger pressure, remembering that it contracts both arms and requests spin. Reverse the selected spin directions if needed, and guide the partners back together with the sticks."
