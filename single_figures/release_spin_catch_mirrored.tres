[resource]
script = ExtResource("1")
title = "Release, spin, catch"
variant_label = "Lady counterclockwise"
description = "Catch, release with a fresh tap of its bumper, then turn the lady counterclockwise with RT. Approach slowly and hold one free bumper to recatch."
narration_text = "Begin with one joined pair of hands. Let the catching bumper up, then tap it again to release. Steer apart and use the right trigger to turn the lady counterclockwise. Release the trigger, approach slowly, and hold one free bumper for a fresh catch. The catch depends on the hands meeting, not on finishing the turn."
requirement = ""
duration = 17.00000000
no_hands = false
single_hand = true
