[ext_resource type="Script" path="res://single_dance_figure.gd" id="1"]

[resource]
script = ExtResource("1")
title = "Release, spin, catch"
variant_label = "Lady clockwise"
description = "Catch once, let that bumper up, then tap it to release. Separate, turn the lady with RT, approach slowly and hold one free bumper to recatch."
narration_text = "Begin with one joined pair of hands. Let the catching bumper up, then tap it again to release. Steer apart and use the right trigger to turn the lady clockwise. Release the trigger, approach slowly, and hold one free bumper for a fresh catch. The catch depends on the hands meeting, not on finishing the turn."
requirement = ""
duration = 17.00000000
no_hands = false
single_hand = true
