[resource]
script = ExtResource("1")
title = "Pendulum"
variant_label = "Clockwise first"
description = "One joined pair. With triggers released, steer a broad swing clockwise, reverse, and return. The sticks control each reversal."
narration_text = "Catch one pair of hands by holding one bumper as the hands approach. Let that bumper up after the catch. With the triggers released, guide a broad swing clockwise, then reverse the path and return. Use the sticks to make the reversal; the hold does not bounce automatically."
