[resource]
script = ExtResource("1")
title = "Open and close"
variant_label = ""
description = "Two-hand hold. Draw both arms inward, pause, then extend together. Explore the arm contraction while maintaining the hold."
narration_text = "Catch the first pair with one bumper and the second pair with the other. The partners face each other with both pairs joined. Draw both arms inward, pause, then extend together. This reference shows the inward and outward arm phrase; trigger pressure also requests spin. Each bumper remains assigned to the pair it caught."
requirement = "Use the other bumper to catch the second pair; each bumper releases its own pair."
duration = 11.00000000
no_hands = false
single_hand = false
