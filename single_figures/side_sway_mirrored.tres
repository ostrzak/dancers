[resource]
script = ExtResource("1")
title = "Side-to-side sway"
variant_label = "Left first"
description = "Two-hand hold. Travel left, then right, and return to centre. Add a small inward arm pulse at each reversal."
narration_text = "Catch the first pair with one bumper and the second pair with the other. Travel together to the left, then to the right, and return to the centre. Add a small inward arm pulse near each reversal. Let the lateral travel and the arm movement form one gentle phrase."
requirement = "Use the other bumper to catch the second pair; each bumper releases its own pair."
