[resource]
script = ExtResource("1")
title = "Concertina travel"
variant_label = "Travel right"
description = "Two-hand hold. Travel right while closing and opening twice. Both arms of each dancer move together."
narration_text = "Catch the first pair with one bumper and the second pair with the other. Travel toward the right side of the floor while closing and opening the hold twice. Both arms of each dancer move together. Keep the travel smooth so the repeated inward and outward movement remains easy to see."
requirement = "Use the other bumper to catch the second pair; each bumper releases its own pair."
duration = 18.00000000
no_hands = false
single_hand = false
