[resource]
script = ExtResource("1")
title = "Behind, release, face, catch"
variant_label = "Gentleman CCW / lady CW"
description = "Release the rear hold and separate. Gentleman turns CCW, lady CW; restore forward arms, then approach for a front catch."
narration_text = "Begin with a rear hand connection. Let the catching bumper up, then tap it again to release. Move apart and turn toward each other: the gentleman counterclockwise and the lady clockwise. Sweep the extended arms forward again with the D-pad. Approach slowly and hold one free bumper for a new front catch."
