script = ExtResource("1")
title = "Mirror slalom"
variant_label = "Travel right"
description = "No hold. Steer right together, widening and narrowing the gap in mirrored curves. Leave triggers released."
narration_text = "The partners travel toward the right side of the floor. Guide them along mirrored curves, widening their separation and then bringing them closer. Keep the triggers released and preserve room between the bodies. Let the two sticks trace the changing lanes together."
